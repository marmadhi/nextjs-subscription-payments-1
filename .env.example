# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Stripe Configuration
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# For production (optional)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
# STRIPE_SECRET_KEY_LIVE=sk_live_...

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# GitHub OAuth (for local development)
# ===========================================
SUPABASE_AUTH_EXTERNAL_GITHUB_REDIRECT_URI="http://127.0.0.1:54321/auth/v1/callback"
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# ===========================================
# AI Provider API Keys
# ===========================================
# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (optional) - https://ai.google.dev/
# GOOGLE_AI_API_KEY=

# Mistral API Key (optional) - https://console.mistral.ai/
# MISTRAL_API_KEY=

# ===========================================
# Admin Configuration
# ===========================================
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# ===========================================
# AI Configuration (optional overrides)
# ===========================================
# Default AI provider (openai, anthropic)
# DEFAULT_AI_PROVIDER=openai

# Default AI model
# DEFAULT_AI_MODEL=gpt-4o-mini

# Enable/disable AI usage tracking
# ENABLE_AI_TRACKING=true

# Enable/disable quota management
# ENABLE_AI_QUOTAS=true
